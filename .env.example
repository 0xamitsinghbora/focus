GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Note: Google Cloud Console requires authorized redirect URIs.
# If using loopback HTTP, authorize ports 3456 through 3460 (e.g. 'http://127.0.0.1:3456/oauth2callback' .. 'http://127.0.0.1:3460/oauth2callback')
# to support automatic fallback when port 3456 is occupied.
# Alternatively, use custom scheme 'focusapp://oauth2callback' or set GOOGLE_OAUTH_DISABLE_PORT_FALLBACK=true.
GOOGLE_OAUTH_REDIRECT_URI="http://127.0.0.1:3456/oauth2callback"
SUPPORT_EMAIL="support@focus.com"