{
  "name": "focus",
  "version": "1.0.0",
  "description": "A minimal daily activity logger",
  "main": "./out/main/index.js",
  "author": "HealthOS",
  "homepage": "https://github.com/healthOS/focus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/healthOS/focus.git"
  },
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "node scripts/patch-electron-icon.js && electron-vite dev -w",
    "db": "node scripts/open-db.js",
    "start": "electron-vite preview",
    "patch:icon": "node scripts/patch-electron-icon.js",
    "build:icons": "node scripts/build-icons.js",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "(electron-builder install-app-deps || echo \"Native dep rebuild failed, skipping...\") && node scripts/patch-electron-icon.js",
    "build:unpack": "npm run build && npm run rebuild:electron && electron-builder --dir",
    "build:win": "npm run build && npm run rebuild:electron && electron-builder --win",
    "build:portable": "npm run build && npm run rebuild:electron && electron-builder --win portable",
    "build:mac": "npm run build && npm run rebuild:electron && electron-builder --mac",
    "build:linux": "npm run build && npm run rebuild:electron && electron-builder --linux",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "node scripts/test-runner.js run",
    "test:watch": "node scripts/test-runner.js",
    "test:node": "node scripts/test-runner.js run",
    "pages:preview": "npx serve docs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.22",
    "electron": "^44.7.2",
    "electron-builder": "^26.5.0",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "happy-dom": "^21.0.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^5.0.5"
  }
}
